# Copy to .env and edit. .env is git-ignored. NEVER commit real values and NEVER paste them into chat or issues.
# Check your setup without revealing anything:   python -m scripts.check_config

# ---- deployment safety (fail-closed defaults) ----
# "dev" relaxes only the startup checks described in docs/SECURITY.md. Anything else is treated as production.
ENVIRONMENT=dev
ENABLE_DOCS=false               # true exposes /docs and /openapi.json (local development only)
ALLOW_UNAUTHENTICATED=false     # only honoured with ENVIRONMENT=dev AND SYSTEM=baseline

# ---- mode ----
SYSTEM=project2                 # baseline | project2 | project1 | project3

# ---- auth: REQUIRED to start the API ----
# Generate once (PowerShell or any shell), paste the output here, keep it out of version control:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_TTL_MINUTES=60

# ---- LLM (any LiteLLM model string) + provider key ----
LLM_MODEL=gpt-4o-mini
JUDGE_MODEL=gpt-4o-mini
# Set only the key for the provider you actually use (leave the others empty):
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Bounds applied to every provider call
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=4096
LLM_MAX_RETRIES=2

# ---- embeddings ----
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDER_BACKEND=sentence-transformers

# ---- stores ----
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=chunks
# SQLite needs no server and no password. For Postgres use `docker compose --profile postgres up -d`,
# set POSTGRES_PASSWORD below, and point DATABASE_URL at it (placeholders in <>).
DATABASE_URL=sqlite:///./rag.db
# DATABASE_URL=postgresql+psycopg2://rag:<POSTGRES_PASSWORD>@127.0.0.1:5433/rag
POSTGRES_PASSWORD=

# ---- retrieval ----
CHUNK_TOKENS=500
CHUNK_OVERLAP_TOKENS=50
TOP_K=5

# ---- Project 1: tiers, cache, routing ----
SMALL_MODEL=gpt-4o-mini
LARGE_MODEL=gpt-4o
CACHE_ENABLED=true
ROUTING_ENABLED=true
CACHE_THRESHOLD=0.97            # set to the MEASURED value from `make tune-cache` (only if it reports a safe threshold)
CACHE_TTL_SECONDS=86400
ESCALATION_MIN_TOP_SCORE=0.30   # embedder-dependent
RUN_LABEL=                      # tags request_log rows (benchmarks set this per arm)

# ---- Project 3: GraphRAG (Neo4j; optional, `docker compose --profile graph up -d neo4j`) ----
GRAPH_BACKEND=neo4j             # neo4j | memory (memory = tests / tiny local runs only)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=                 # choose one; the Neo4j container takes its password from this same variable
EXTRACTION_MODEL=gpt-4o-mini    # builds the graph AND extracts question entities (LLM mode)
GRAPH_HOPS=2                    # PDF: 1-2 hops
GRAPH_HUB_DEGREE_CAP=50         # never walk THROUGH an entity with more neighbours than this
VECTOR_K=10                     # vector candidates entering the merge (final context = TOP_K)
GRAPH_LIMIT=20                  # graph candidates entering the merge
QUESTION_ENTITIES=llm           # llm | ngram (dictionary match, zero LLM cost)
RERANKER_BACKEND=cross-encoder  # lexical = offline TEST stub only
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
EXTRACTION_CACHE_PATH=data/processed/extraction_cache.jsonl
