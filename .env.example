# ---- mode ----
SYSTEM=project2                 # baseline | project2 | project1 | project3
# ---- LLM (any LiteLLM model string) + provider key ----
LLM_MODEL=gpt-4o-mini
JUDGE_MODEL=gpt-4o-mini
OPENAI_API_KEY=                 # or ANTHROPIC_API_KEY / use ollama/llama3.1 for a local model
# ---- embeddings ----
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDER_BACKEND=sentence-transformers
# ---- stores ----
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=chunks
DATABASE_URL=postgresql+psycopg2://rag:rag@localhost:5433/rag
# ---- retrieval ----
CHUNK_TOKENS=500
CHUNK_OVERLAP_TOKENS=50
TOP_K=5
# ---- auth (CHANGE the secret; >= 32 bytes) ----
JWT_SECRET=CHANGE-ME-dev-only-secret-at-least-32-bytes
JWT_ALGORITHM=HS256
JWT_TTL_MINUTES=60
# ---- Project 1: tiers, cache, routing ----
SMALL_MODEL=gpt-4o-mini
LARGE_MODEL=gpt-4o
CACHE_ENABLED=true
ROUTING_ENABLED=true
CACHE_THRESHOLD=0.97            # set to the MEASURED value from `make tune-cache` (only if it reports a safe threshold)
CACHE_TTL_SECONDS=86400
ESCALATION_MIN_TOP_SCORE=0.30   # embedder-dependent
RUN_LABEL=                      # tags request_log rows (benchmarks set this per arm)
# ---- Project 3: GraphRAG (Neo4j) ----
GRAPH_BACKEND=neo4j             # neo4j | memory (memory = tests / tiny local runs only)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=rag-dev-password # must match docker-compose.yml NEO4J_AUTH
EXTRACTION_MODEL=gpt-4o-mini    # builds the graph AND extracts question entities (LLM mode)
GRAPH_HOPS=2                    # PDF: 1-2 hops
GRAPH_HUB_DEGREE_CAP=50         # never walk THROUGH an entity with more neighbours than this
VECTOR_K=10                     # vector candidates entering the merge (final context = TOP_K)
GRAPH_LIMIT=20                  # graph candidates entering the merge
QUESTION_ENTITIES=llm           # llm | ngram (dictionary match, zero LLM cost)
RERANKER_BACKEND=cross-encoder  # lexical = offline TEST stub only
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
EXTRACTION_CACHE_PATH=data/processed/extraction_cache.jsonl
